{
  "name": "dsh-flowforge",
  "version": "0.1.0",
  "description": "FlowForge for DeepSeek Harness: forge personal DIY workflows step by step in a top-right panel, with suggestions, self-check gating (hard block / soft acknowledge), preset jumps with AI-proposed-jump approval, and step-by-step execution by the main conversation agent with a live progress panel.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "workflow",
    "automation",
    "prompt-chaining"
  ],
  "author": "R-roker315",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
